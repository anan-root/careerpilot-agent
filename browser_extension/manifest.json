{
  "manifest_version": 3,
  "name": "CareerPilot Job Importer",
  "version": "0.1.0",
  "description": "Import the current job page into the local CareerPilot API.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CareerPilot"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
